<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical" android:padding="16dp"
        android:background="#ED090B10">
        <TextView android:id="@+id/fm_player_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="18sp" android:maxLines="1" android:ellipsize="end"/>
        <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress" android:layout_width="match_parent"
            android:layout_height="40dp" android:focusable="true"
            app:bar_height="4dp" app:played_color="#EDC365" app:scrubber_color="#FFFFFF"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/fm_player_previous" style="@style/FilmPlayerIcon" android:src="@drawable/player_previous" android:contentDescription="@string/ux_episode_previous"/>
            <ImageButton android:id="@+id/fm_player_rewind" style="@style/FilmPlayerIcon" android:src="@drawable/player_rewind" android:contentDescription="@string/tv_player_rewind"/>
            <ImageButton android:id="@id/exo_play_pause" android:layout_width="52dp" android:layout_height="48dp"
                android:background="@drawable/tv_focus" android:tint="#FFFFFF" android:padding="10dp"
                android:focusable="true" android:contentDescription="@string/tv_player_toggle"
                android:src="@android:drawable/ic_media_play"/>
            <ImageButton android:id="@+id/fm_player_forward" style="@style/FilmPlayerIcon" android:src="@drawable/player_forward" android:contentDescription="@string/tv_player_forward"/>
            <ImageButton android:id="@+id/fm_player_next" style="@style/FilmPlayerIcon" android:src="@drawable/player_next" android:contentDescription="@string/ux_episode_next"/>
            <TextView android:id="@id/exo_position" android:layout_width="55dp" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
            <TextView android:layout_width="10dp" android:layout_height="wrap_content" android:text="/"
                android:textColor="#ADB6C7" android:importantForAccessibility="no"/>
            <TextView android:id="@id/exo_duration" android:layout_width="55dp" android:layout_height="wrap_content"
                android:textColor="#ADB6C7" android:textSize="12sp" android:gravity="center"/>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <ImageButton android:id="@+id/fm_player_sources" style="@style/FilmPlayerIcon" android:src="@drawable/player_sources" android:contentDescription="@string/tv_source"/>
            <ImageButton android:id="@+id/fm_player_quality" style="@style/FilmPlayerIcon" android:src="@drawable/player_quality" android:contentDescription="@string/tv_player_quality"/>
            <ImageButton android:id="@+id/fm_player_audio" style="@style/FilmPlayerIcon" android:src="@drawable/player_audio" android:contentDescription="@string/tv_player_audio"/>
            <ImageButton android:id="@+id/fm_player_subtitles" style="@style/FilmPlayerIcon" android:src="@drawable/player_subtitles" android:contentDescription="@string/tv_player_subtitles"/>
            <ImageButton android:id="@+id/fm_player_settings" style="@style/FilmPlayerIcon" android:src="@drawable/player_settings" android:contentDescription="@string/tv_player_settings"/>
            <ImageButton android:id="@+id/fm_player_exit" style="@style/FilmPlayerIcon" android:src="@drawable/player_exit" android:contentDescription="@string/tv_exit"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
